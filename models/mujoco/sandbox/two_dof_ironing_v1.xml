<mujoco model="two_dof_ironing_rl_sandbox">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast"/>
  <default>
    <joint limited="true" damping="0.25" armature="0.02"/>
    <geom type="capsule" contype="0" conaffinity="0" rgba="0.62 0.67 0.72 1"/>
    <motor ctrllimited="true"/>
  </default>
  <worldbody>
    <light pos="0 -1 2" dir="0 1 -1"/>
    <body name="upper_arm" pos="0 0 1.4">
      <joint name="r_shoulder_elev" type="hinge" axis="0 1 0" range="-1.2 1.5"/>
      <geom name="upper_arm_geom" fromto="0 0 0 0 0 -0.30" size="0.035" mass="2.1"/>
      <body name="forearm" pos="0 0 -0.30">
        <joint name="r_elbow_flex" type="hinge" axis="0 1 0" range="0.05 2.25"/>
        <geom name="forearm_geom" fromto="0 0 0 0 0 -0.25" size="0.03" mass="1.4"/>
        <body name="iron" pos="0 0 -0.25">
          <geom name="iron_proxy" type="box" size="0.055 0.035 0.035" mass="1.2" rgba="0.25 0.28 0.32 1"/>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="human_shoulder_motor" joint="r_shoulder_elev" gear="1" ctrlrange="-30 30"/>
    <motor name="human_elbow_motor" joint="r_elbow_flex" gear="1" ctrlrange="-15 15"/>
    <motor name="exo_shoulder_motor" joint="r_shoulder_elev" gear="1" ctrlrange="-5 5"/>
    <motor name="exo_elbow_motor" joint="r_elbow_flex" gear="1" ctrlrange="-3 3"/>
  </actuator>
</mujoco>
